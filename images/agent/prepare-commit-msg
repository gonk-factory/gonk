#!/bin/sh
# git prepare-commit-msg hook: installed into the rig clone's .git/hooks/ at
# session start by images/agent/entrypoint.sh (AD-4 -- commit provenance is a
# git hook, not agent prose, because a trailer the agent is ASKED to write is
# a trailer the agent will sometimes forget, reword, or hallucinate a cost
# into).
#
# Task 8 landed `gonk-gate trailers` (cmd/gonk-gate/trailers.go): it reads
# this session's attribution identity from GC_WEBHOOK_ARG_METADATA_JSON/
# GC_WEBHOOK_ARG_MODEL (the same env the agent pod already carries for the
# OTHER attribution seam, OD-7), asks gonk-meter for this project's
# provenance policy (commit_trailers/include_usage) and, if asked, the
# session's cost, and splices the resulting trailer block into the commit
# message file -- IDEMPOTENTLY (re-running it, e.g. on `commit --amend`,
# never duplicates the block).
#
# git's own contract: $1 = path to the commit message file, $2 = source
# (message|template|merge|squash|commit, optional), $3 = a commit SHA1 (only
# when $2 is "commit"). A prepare-commit-msg hook edits $1 in place.
#
# IT MUST NEVER FAIL A COMMIT. gonk-gate trailers itself already degrades
# every failure (no attribution identity, meter unreachable, an incomplete
# session cost) to "leave the message alone" or `Gonk-Usage: pending` and
# always exits 0 -- the `|| true` and explicit `exit 0` below are a second,
# belt-and-suspenders layer: losing the agent's real work over a metadata
# footer is a trade this hook never makes, even if gonk-gate itself changes
# its own exit-code contract later.
set -u
gonk-gate trailers --commit-msg-file "$1" || true
exit 0
