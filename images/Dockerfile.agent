# gonk agent image: opencode + the tooling a session needs to do real work on a
# GitLab project. One pod per active session (spec 4.1); pools scale to zero.
#
# Derived from gascity's contrib/k8s/Dockerfile.agent (MIT,
# github.com/gastownhall/gascity @ GASCITY_REF -- see images/versions.env).
# NOTHING here is derived from gastownhall/gascity-packs, which carries no
# licence (see pack/pack.toml's header comment for the full constraint).
#
# Build: see `make images` (Makefile). Every ARG below is read from
# images/versions.env; there is no default and no `latest` anywhere.

ARG GO_VERSION
ARG DEBIAN_BASE

# ---- build gonk-gate (static; the agent needs `trailers`/`check`) -----------
FROM golang:${GO_VERSION} AS gate
WORKDIR /src
ARG GONK_TAG
# vendor/ is committed (docs/environment.md: CI cannot reach proxy.golang.org)
# -- this build is fully offline, -mod=vendor, no `go mod download` anywhere.
COPY go.mod go.sum ./
COPY vendor/ vendor/
COPY cmd/ cmd/
COPY internal/ internal/
COPY pkg/ pkg/
# NOTE: cmd/gonk-gate does not yet declare `var version string` or handle
# `--version` (confirmed against cmd/gonk-gate/main.go, 2026-07-16) -- the -X
# below is a harmless no-op linker directive until that lands. Flagged for
# whichever task adds it (Task 5's own smoke-test wishlist and Task 6's
# controller smoke test both want `gonk-gate --version`; see PLAN.md).
RUN CGO_ENABLED=0 go build -mod=vendor -trimpath -ldflags="-s -w -X main.version=${GONK_TAG}" \
    -o /out/gonk-gate ./cmd/gonk-gate

# ---- fetch opencode, glab, bd (pinned; checksum-verified) -------------------
# A separate stage so `curl`/`tar` never ship in the runtime image, and so a
# checksum mismatch fails the BUILD, not a running pod.
FROM debian:trixie-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd AS fetch
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl tar \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /fetch

ARG OPENCODE_VERSION
RUN test -n "${OPENCODE_VERSION}" || (echo "OPENCODE_VERSION is unset -- refusing to build an agent on a floating opencode (OD-3)" && exit 1)
# opencode ships a self-contained static Linux binary release (no npm/node
# needed at runtime -- @ai-sdk/openai-compatible, the AI SDK adapter the
# attribution overlay below targets, is COMPILED IN: verified against
# opencode's own source, packages/opencode/src/provider/provider.ts's
# BUNDLED_PROVIDERS map, at this exact tag). That matters here: spec 9's
# design intent is agent-pod egress to GitLab and LiteLLM ONLY -- an opencode
# that fetched its provider adapter from the npm registry at session start
# would need a third egress target this pack never asked for.
RUN curl -fsSL -o opencode.tar.gz \
      "https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/opencode-linux-x64.tar.gz" \
    && echo "60f27b2679f00a511b6539f97e02448afaf58d9c66e2448285ea0c517ca84583  opencode.tar.gz" | sha256sum -c - \
    && tar xzf opencode.tar.gz \
    && chmod +x opencode

ARG GLAB_VERSION
RUN test -n "${GLAB_VERSION}" || (echo "GLAB_VERSION is unset" && exit 1)
RUN curl -fsSL -o glab.tar.gz \
      "https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/packages/generic/glab/${GLAB_VERSION}/glab_${GLAB_VERSION}_linux_amd64.tar.gz" \
    && echo "cb3eb9d6b05eedef24a028b52354f12fb9a07ecfa0b5581eb161176585bc8213  glab.tar.gz" | sha256sum -c - \
    && tar xzf glab.tar.gz bin/glab \
    && chmod +x bin/glab

ARG BD_VERSION
RUN test -n "${BD_VERSION}" || (echo "BD_VERSION is unset" && exit 1)
RUN curl -fsSL -o bd.tar.gz \
      "https://github.com/gastownhall/beads/releases/download/v${BD_VERSION}/beads_${BD_VERSION}_linux_amd64.tar.gz" \
    && echo "b0f3dd607c3fb989ee08d0a6854fba80d0402971eb108f9af6170bc14d491a34  bd.tar.gz" | sha256sum -c - \
    && tar xzf bd.tar.gz bd \
    && chmod +x bd

# ---- runtime -----------------------------------------------------------------
FROM debian:trixie-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd

# git: the rig clone and the prepare-commit-msg hook (Task 8).
# ca-certificates: TLS trust roots for the one endpoint the agent talks to,
# LiteLLM. Under the broker design the agent never reaches the forge, so no
# forge CA is trusted here (that egress lives in the broker, not this pod).
# jq: entrypoint.sh renders overlay/opencode.json with it -- guarantees valid
# JSON (correct escaping of the verbatim atags metadata blob) instead of
# hand-built string concatenation.
# tmux: Gas City's k8s session provider launches the agent as
# `tmux new-session -d -s <s> "$CMD"` (internal/runtime/k8s/pod.go @ GASCITY_REF)
# -- it OVERRIDES this image's ENTRYPOINT and wraps the agent command in tmux, so
# the binary must be present or the session pod dies before opencode ever starts.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates jq tmux \
    && rm -rf /var/lib/apt/lists/*

COPY --from=fetch /fetch/opencode      /usr/local/bin/opencode
COPY --from=fetch /fetch/bin/glab      /usr/local/bin/glab
COPY --from=fetch /fetch/bd            /usr/local/bin/bd
COPY --from=gate  /out/gonk-gate       /usr/local/bin/gonk-gate
COPY images/agent/entrypoint.sh        /usr/local/bin/gonk-agent-entrypoint
COPY images/agent/prepare-commit-msg   /usr/local/share/gonk/prepare-commit-msg
RUN chmod +x /usr/local/bin/gonk-agent-entrypoint /usr/local/share/gonk/prepare-commit-msg

# No forge CA is trusted here. Under the broker design (spec 9/10) the agent pod
# never reaches gitlab.orac.local -- the broker reads the issue and posts the
# comment on its behalf -- so the orac private CA is NOT mounted or trusted in
# this image (the /etc/ssl/orac/ca.crt file this image used to point at via
# SSL_CERT_FILE/GIT_SSL_CAINFO was never even mounted). If the agent's one
# remaining egress, LiteLLM, is ever served from a private CA, that trust is a
# chart-level mount concern for that endpoint, not a baked-in image ENV.

# No /etc/passwd entry for 65532 (this base image is plain debian, not
# distroless) -- HOME must be explicit or git/opencode fall back to "/" and
# fail to write .gitconfig/.config as a non-root uid with no home directory.
RUN mkdir -p /workspace /etc/gonk/overlay && chown -R 65532:65532 /workspace /etc/gonk
ENV HOME=/workspace
WORKDIR /workspace
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/gonk-agent-entrypoint"]
